#!/usr/bin/env bash
# One-command setup. Safe to re-run: it skips whatever is already done.
set -euo pipefail

cd "$(dirname "$0")"

say() { printf '\n\033[1;33m==>\033[0m %s\n' "$1"; }
die() { printf '\n\033[1;31mx\033[0m %s\n\n' "$1" >&2; exit 1; }

command -v php >/dev/null || die "PHP is not installed. Card Forge needs PHP 8.4 or newer, or run it with Docker instead: docker compose up"
command -v composer >/dev/null || die "Composer is not installed. See https://getcomposer.org/download/"
command -v npm >/dev/null || die "Node and npm are not installed. See https://nodejs.org"

php -r 'exit(version_compare(PHP_VERSION, "8.4.1", ">=") ? 0 : 1);' \
    || die "PHP $(php -r 'echo PHP_VERSION;') is too old. Card Forge needs 8.4.1 or newer, or run it with Docker: docker compose up"

php -m | grep -qi '^pdo_sqlite$' \
    || die "The pdo_sqlite PHP extension is missing. Install it (php-sqlite3 on Debian and Ubuntu, bundled with Homebrew PHP on macOS)."

say "Installing PHP packages"
if ! composer install --no-interaction; then
    cat >&2 <<'HELP'

  Composer could not install the locked packages on this PHP version.

  If the message above names a package that does not support your PHP, the
  lock file needs refreshing for it:

      composer update <the package it named> -W

  Please also open an issue so the lock file can be fixed for everyone.

HELP
    exit 1
fi

say "Installing frontend packages"
npm install --no-fund --no-audit

if [ ! -f .env ]; then
    say "Creating .env"
    cp .env.example .env
    php artisan key:generate --ansi
else
    echo "  .env already exists, leaving it alone"
fi

if [ ! -f database/database.sqlite ]; then
    say "Creating the database"
    touch database/database.sqlite
fi

# Blade compiles the Inertia root view to disk. A cached copy from an older
# Inertia version renders markup the current client cannot read, which shows up
# as a blank page rather than an error.
say "Clearing cached views and config"
php artisan view:clear --ansi
php artisan config:clear --ansi

say "Creating the tables and importing design/"
php artisan migrate --force --ansi
php artisan design:import --ansi

say "Building the frontend"
npm run build

cat <<'DONE'

  Card Forge is ready.

    composer dev      start it (app on http://localhost:8000, assets rebuilt as you edit)
    php artisan serve just the app, using the assets already built

  The design folder is the source of truth:

    php artisan design:import    design/ -> the editor
    php artisan design:export    the editor -> design/, then commit design/

DONE
